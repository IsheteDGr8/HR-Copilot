# Azure Cosmos DB — employee records (Phase 16)
# Prefer endpoint + key; COSMOS_CONNECTION_STRING is also supported as a fallback.
COSMOS_ENDPOINT="your-endpoint"
COSMOS_KEY="your-key"
# Real ClosedAI seed data lives in closedai-db / employees (not an empty hr_database).
COSMOS_DATABASE_NAME="closedai-db"
COSMOS_CONTAINER_NAME="employees"
COSMOS_DOCUMENTS_CONTAINER="documents"
COSMOS_BANDS_CONTAINER="compensation_bands"
COSMOS_CHECKLISTS_CONTAINER="onboarding_checklists"

# Azure Blob Storage
# AZURE_BLOB_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"
BLOB_CONTAINER_NAME="onboarding-forms"
BLOB_SAS_HOURS=24

# Microsoft identity (Graph / Teams / Outlook)
# MSAL_CLIENT_ID=
# MSAL_CLIENT_SECRET=
# MSAL_TENANT_ID=
# MSAL_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback
# Space-separated Graph scopes; defaults to User.Read Mail.Send Chat.ReadWrite
# MSAL_GRAPH_SCOPES="https://graph.microsoft.com/User.Read https://graph.microsoft.com/Mail.Send https://graph.microsoft.com/Chat.ReadWrite"

# Optional legacy / shared connection string (used if ENDPOINT/KEY are unset)
# COSMOS_CONNECTION_STRING="AccountEndpoint=...;AccountKey=...;"
# Shared secret for inbound webhooks (document-signed, IT ticket ack). Required to enable /api/v1/webhooks/*
# WEBHOOK_SHARED_SECRET=

# IT provisioning dispatch. "mock" (default) generates a ticket id and logs it;
# "teams" is reserved for the real Graph Chat.Send / external ticketing handoff.
# IT_DISPATCH_MODE=mock
# IT_TEAMS_CHAT_ID=

USE_MOCK_AZURE=false
