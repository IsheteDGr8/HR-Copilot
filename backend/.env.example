# Azure Cosmos DB — employee records (Phase 16)
# Prefer endpoint + key; COSMOS_CONNECTION_STRING is also supported as a fallback.
COSMOS_ENDPOINT="your-endpoint"
COSMOS_KEY="your-key"
# Real ClosedAI seed data lives in closedai-db / employees (not an empty hr_database).
COSMOS_DATABASE_NAME="closedai-db"
COSMOS_CONTAINER_NAME="employees"
COSMOS_DOCUMENTS_CONTAINER="documents"

# Azure Blob Storage (onboarding form URLs / generated-reports)
# AZURE_BLOB_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"
# Container names: lowercase + hyphens only (no underscores). Cosmos blob:// URLs use generated-reports.
BLOB_CONTAINER_NAME="generated-reports"

# Optional legacy / shared connection string (used if ENDPOINT/KEY are unset)
# COSMOS_CONNECTION_STRING="AccountEndpoint=...;AccountKey=...;"
USE_MOCK_AZURE=false
