# Copy to frontend/.env.local (never commit real keys).

# Intake page mini-chatbot (AiSummaryPanel → /api/ai-summary)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://<your-resource>.openai.azure.com/openai/v1
OPENAI_MODEL=gpt-5.2

# Optional. Most /api/v1 calls go through the Next rewrite to localhost:8000.
NEXT_PUBLIC_HRAGENT_API_URL=http://localhost:8000
